---
import Layout from "../components/Layout.astro";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = [
  {
    title: "Agentic AI Census Management POC",
    icon: "lucide:workflow",
    client: "AON Corporation",
    role: "AI Engineer · Backend Engineer",
    tags: ["AI Engineer", "Backend", "Insurance"],
    tech: "Semantic Kernel, AI Agents (AI Foundry), Azure OpenAI, Azure Functions, Python, Power Automate, Cosmos DB, Azure Storage",
    summary:
      "Built a multi-agent orchestration platform for automating census management across emails, spreadsheets, and carrier invoices, with Cosmos DB as the source of truth.",
    useCase: {
      opportunity:
        "Benefits and insurance teams needed a reliable way to consolidate census data from multiple sources while reducing manual reconciliation effort.",
      objective:
        "Automate end-to-end census processing using a fleet of kernel-based agents that parse, validate, reconcile, and summarize member data into Cosmos DB.",
      keyFeatures: [
        "Multi-source ingestion from email (.eml/.msg), Excel (.xlsx), and carrier invoices",
        "AI-powered extraction and intent recognition for Joiner/Mover/Leaver events",
        "Automated policy evaluation for eligibility, coverage, and premium computation",
        "Invoice reconciliation against master data with discrepancy reporting",
        "Per-field and per-record confidence scoring",
        "Automated outbound communications summarizing each orchestration run"
      ],
      services: [
        "Email Parser Agent – parses .eml files from Azure Blob Storage and extracts structured data using Azure OpenAI",
        "Document Parser Agent – parses Excel files and returns cleaned structured output",
        "Data Intent Recognizer Agent – determines Joiner/Mover/Leaver intent for each record",
        "Data Formatter Agent – normalizes extracted data into standardized JSON",
        "Field Data Validator Agent – validates mandatory fields (DOB, salary, ID, currency, etc.)",
        "Policy Eligibility Evaluation Agent – computes coverage and premiums using policy rules",
        "Data Mapper Agent – maps email data into Cosmos DB member records",
        "Process Summarizer Agent – aggregates counts of processed and failed records",
        "Communications Agent – composes summary emails using Azure OpenAI",
        "Orchestrator Agent – coordinates the full census data management flow",
        "Reconciler Super Agent – performs invoice reconciliation and discrepancy analysis",
        "XLSX Generator Agent – outputs reconciled Excel files back to Blob Storage"
      ],
      designPrinciples: [
        "Single responsibility – each agent handles exactly one task to simplify testing and evolution",
        "Asynchronous processing – agents support concurrent workloads for scale",
        "Semantic Kernel integration – consistent use of @kernel_function for agent definitions",
        "Error isolation – failures are contained at the agent level and do not crash the entire system",
        "JSON-based communication – structured payloads passed between orchestration stages"
      ],
      architecture: {
        overview:
          "An Azure-hosted multi-agent system built with Semantic Kernel, Azure Functions, Blob Storage, and Cosmos DB, orchestrated via Power Automate.",
        components: [
          "Azure Blob Storage for email, census files, and carrier invoices",
          "Azure Functions hosting Semantic Kernel agents",
          "Cosmos DB as the master member and census data store",
          "Power Automate flows to trigger mock inboxes and orchestration jobs",
          "Agent Supervisor workbench and dashboards for monitoring and reconciliation"
        ]
      }
    }
  },
  {
    title: "Agentic AI Laptop Refresh",
    icon: "lucide:laptop",
    client: "Qualcomm Inc.",
    role: "Application Developer",
    tags: ["AI Engineer", "Microsoft 365"],
    tech: "Copilot Studio, Power Automate, ServiceNow, Adaptive Cards, Dataverse",
    summary:
      "Designed and configured an agentic automation solution to modernize Qualcomm’s laptop refresh lifecycle using Copilot Studio, Power Automate, and ServiceNow integration.",

    useCase: {
      opportunity:
        "Qualcomm aims to automate its Laptop Refresh Process using a Copilot Studio Agent integrated with Power Automate and ServiceNow to reduce manual IT coordination and improve employee experience.",

      objective:
        "Streamline device refresh workflows by proactively engaging eligible employees, orchestrating backend processes, and reducing annual manual intervention by IT administrators.",

      goals: [
        "Proactive identification of refresh-eligible employees",
        "Automated conversational engagement via Teams/Copilot",
        "End-to-end orchestration across logistics, audit, security, and provisioning",
        "Scalable architecture for enterprise-wide rollout"
      ],

      workflow: [
        "Recurring flow identifies eligible employees via scheduled job",
        "Copilot Studio agent initiates proactive chat engagement",
        "User selects actions: device readiness, audit check, delivery scheduling",
        "Orchestrator agent coordinates sub-agents (Audit, Logistics, Asset, Security, Policy)",
        "Power Automate integrates with ServiceNow and enterprise systems",
        "Status updates tracked via Dataverse and monitoring flows",
        "Improved employee experience through consistent and intelligent IT engagement",
        "Reduced manual coordination by IT teams",
        "Higher operational efficiency and traceability",
        "Foundation for scalable enterprise automation initiatives"
      ],

      services: [
        
          "The solution follows an agentic orchestration model combining Copilot Studio, Power Automate flows, Azure Functions, and ServiceNow integration.",
          "Copilot Studio – Conversational agent and user engagement",
          "Power Automate – Workflow orchestration and backend triggers",
          "ServiceNow – Ticketing and provisioning integration",
          "Dataverse – Workflow and state tracking",
          "Azure Functions – Scheduled employee eligibility sync",
          "Agent Framework – Audit, Logistics, Asset, Security, and Policy sub-agents"
      ]
    }
  },
  {
    title: "Project HERMES – HR Copilot & Case Automation",
    icon: "lucide:messages-square",
    client: "HR & Employee Services POC",
    role: "AI Engineer · Microsoft 365 Developer",
    tags: ["Copilot Studio", "Teams", "Automation"],
    tech: "Copilot Studio, Microsoft Teams, OpenAI, AI Search, Language Services, Azure Functions, ServiceNow, Document Intelligence, SharePoint Lists, Adaptive Cards",
    summary:
      "Built an intelligent HR assistant in Microsoft Teams that orchestrates Q&A, ticketing, leave filing, claims, and onboarding through Copilot Studio and Azure Functions.",
    useCase: {
      opportunity:
        "HR teams needed a single conversational entry point in Teams to handle policy questions, leave, claims, and ServiceNow tickets without users jumping between tools.",
      objective:
        "Deliver an AI-powered HR copilot (Hermes) that routes each request to the right back-end system while providing grounded, explainable responses.",
      features: [
        "Teams-based option selector for HR policy, ticketing, claims, leave, and enrollment journeys",
        "Context-aware responses powered by OpenAI and AI Search over HR documents",
        "Citation panel with source files for each answer",
        "Follow-up questions and translations to keep the conversation flowing",
        "Adaptive Card forms for claims, leave filing, and onboarding flows",
        "Automatic ServiceNow incident/request creation from chat",
        "Expense reimbursement and leave approval summaries surfaced in Teams"
      ],
      workflow: [
        "User interacts with Hermes in Teams via Copilot Studio topics and option selector cards",
        "Azure Functions route each request to OpenAI, AI Search, Language Services, or line-of-business APIs",
        "HR knowledge content is indexed via AI Search and Document Intelligence",
        "ServiceNow, SharePoint, and other systems are updated through Power Automate and Adaptive Cards",
        "Hermes returns a rich card with responses, citations, and next-step suggestions"
      ],
      architecture: {
        overview:
          "Hermes is an extensible AI search and orchestration framework that connects Teams with Copilot Studio, Azure Functions, OpenAI, AI Search, Language Services, ServiceNow, and SharePoint.",
        components: [
          "Microsoft Teams + Copilot Studio as the primary conversational interface",
          "Azure Functions as the central router for tool and service calls",
          "OpenAI for generative and grounded responses",
          "Azure AI Search over HR and policy content",
          "Language Services for intent detection, sentiment, and translation",
          "Azure Data Factory and Document Intelligence for ingesting structured and unstructured data",
          "ServiceNow for ticket creation and workflow execution",
          "SharePoint Lists and other line-of-business stores for configuration and transactions",
          "Adaptive Cards for interactive forms and confirmation screens in Teams"
        ]
      }
    }
  },
  {
  title: "eFax Automation for Healthcare",
  icon: "lucide:brain-circuit",
  client: "Providence St. Joseph Health",
  role: "Application Developer · Data Engineer · DevOps",
  tags: ["AI Engineer", "Backend", "Healthcare"],
  tech: "Python, FastAPI, Azure OpenAI, Azure AI Search, Azure AI Document Intelligence, PostgreSQL, Azure Blob Storage, pytest",
  summary:
    "Designed and implemented an AI-driven document ingestion and classification solution for healthcare eFax workflows.",
  
  useCase: {
    opportunity: `
    To help address workforce shortages and reduce caregiver burnout, Providence explored automation of manual faxed referrals that were causing delays and inefficiencies in patient scheduling.
        `,
        objective: `
    Streamline the referral intake process by minimizing manual work and improving the patient experience.
        `,
        goals: [
          "Automated identification, labeling, and processing of faxed referrals",
          "Direct population of extracted data into Epic referral forms",
          "Reduced call volume and faster scheduling workflows"
        ],
        workflow: [
          "Document fetching and ingestion from external systems",
          "Document splitting for uncertain status",
          "OCR processing for text and metadata extraction",
          "Duplicate detection using vector similarity search",
          "AI-based classification and referral metadata extraction",
          "Database updates and workflow orchestration",
          "Cleanup and index management"
        ],
        services: [
          "PreprocessService – document fetching and splitting",
          "PostgreSQLService – database interaction",
          "OCRService – optical character recognition",
          "OpenAIService – classification and metadata extraction",
          "AISearchService – vector search indexing",
          "StorageService – blob storage handling"
        ]
    }
  },
  {
    title: "Metaverse & XR Initiatives",
    icon: "lucide:layers",
    client: "ATCP / Avanade CTO",
    role: "XR Developer (Unity & Microsoft Mesh)",
    tags: ["XR", "Metaverse", "Full-Stack"],
    tech: "Unity, Microsoft Mesh, Azure Services, C#, Generative AI, Speech Services",
    summary:
      "Led and delivered immersive Microsoft Mesh and XR initiatives across retail, healthcare, learning, and enterprise innovation scenarios.",

    useCase: {
      opportunity:
        "Organizations explored Microsoft Mesh and immersive XR environments to improve collaboration, learning, retail engagement, and clinical innovation through secure and scalable virtual experiences.",

      objective:
        "Design and build immersive proof-of-concepts and production-ready XR environments leveraging Microsoft Mesh, Azure, and Unity to demonstrate real-world enterprise value.",

      initiatives: [
        {
          name: "Microsoft Mesh Demo Worlds",
          description:
            "Built and tested collaborative demo environments to showcase Microsoft Mesh capabilities in mixed reality collaboration.",
          highlights: [
            "End-to-end testing of Microsoft Mesh toolkits",
            "Integration with Generative AI services",
            "Visual & cloud scripting integration",
            "Advanced animations, physics, and user interactions",
            "Speech and text service integration"
          ]
        },
        {
          name: "MetaCartXR – XR Sales & Marketing",
          description:
            "Developed an immersive retail metaverse experience enabling users to browse and interact with products in a virtual showroom.",
          highlights: [
            "Virtual product exploration and interaction",
            "Digital twin modeling for appliances",
            "Secure integration with enterprise systems",
            "Scalable architecture for commercial rollout"
          ]
        },
        {
          name: "LifeWorks VR – B2B Mental Health (Microsoft Mesh)",
          description:
            "Designed a proof-of-concept metaverse experience to support clinical exposure therapy and mental health innovation.",
          highlights: [
            "Design sprint with clinical and business stakeholders",
            "Virtual environments for exposure therapy use cases",
            "Secure therapist-guided immersive experiences",
            "Narrative demo environments for executive presentation"
          ]
        },
        {
          name: "Expert Learning Lab – Microsoft Mesh",
          description:
            "Created immersive learning and team-building environments to enhance collaboration and virtual training.",
          highlights: [
            "Interactive VR learning simulations",
            "Cross-platform integration with Teams and Azure",
            "Support for multiple VR/AR devices",
            "Scalable enterprise learning architecture"
          ]
        }
      ],

      architecture: {
        overview:
          "All XR initiatives leveraged Microsoft Mesh and Unity integrated with Azure cloud services to provide secure, scalable, and interactive immersive environments.",
        components: [
          "Microsoft Mesh – Collaborative mixed reality environments",
          "Unity – 3D world development and interaction logic",
          "Azure Services – Identity, storage, and backend integration",
          "Generative AI Services – AI-driven content and interaction",
          "Speech & Text Services – Real-time conversational experiences",
          "Cloud & Visual Scripting – Modular and scalable architecture"
        ]
      },

      impact: [
        "Accelerated executive understanding of Metaverse potential",
        "Enabled innovative clinical treatment prototypes",
        "Improved immersive retail engagement concepts",
        "Advanced enterprise learning and collaboration models"
      ]
    }
  },
  {
    title: "Modern Workplace Capability",
    icon: "lucide:briefcase",
    client: "Avanade",
    role: "Trainer · O365 SME · Developer",
    tags: ["Microsoft 365", "Automation"],
    tech: "SharePoint Online, Power Automate, PVA, SPFx, OneDrive",
    summary:
      "Acted as main training coordinator and SME for Modern Workplace. Built internal tools including automated item count, email notification engines, and migration dashboards, plus chatbots using Power Virtual Agents integrated with Teams."
  },
  {
    title: "Enterprise SharePoint & Web Migrations",
    icon: "lucide:database",
    client: "NTT Data / Central Bank of the Philippines / ABS-CBN Corp",
    role: "Developer / Main Developer",
    tags: ["Backend", "Microsoft 365"],
    tech: "SharePoint On-Prem, SharePoint Online, Office 365, Web Development",
    summary:
      "Delivered multiple migrations from legacy systems and websites to SharePoint and Office 365. Implemented support modules, handled content migration, and ensured a stable and maintainable modern workplace platform.",
    useCase: {
      impact: {
        text: "BSP's Enhanced Website Wins Central Banking Award",
        link: "https://www.bsp.gov.ph/SitePages/MediaAndResearch/MediaDisp.aspx?ItemId=5715"
      }
    }
  }
];
---

<Layout title="Projects – Shara Mae">
  <Header />

  <main class="shell">
    <section class="panel-wrapper">
    <div class="panel">
      <h2>Selected projects</h2>
      <p>
        A sample of work across AI, backend, Microsoft 365, and full-stack/XR. These projects
        focus on real enterprise use-cases with measurable impact and production-ready
        implementations.
      </p>
    </div>
    </section>
    <section class="projects-grid">
        {projects.map((project) => (
          <ProjectCard {...project} />
        ))}
    </section>
  </main>
</Layout>

<style>
  h2 {
    margin-bottom: 0.5rem;
  }

  .intro {
    max-width: 640px;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
  }

  .projects-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
